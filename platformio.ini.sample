[platformio]
; Bare `pio run` (and the IDE Build button) builds only the firmware.
; The host unit tests are opt-in: `pio test -e native`.
default_envs = nodemcuv2

[env:nodemcuv2]
platform = espressif8266
board = nodemcuv2
framework = arduino
monitor_speed = 115200
lib_deps = 
	knolleary/PubSubClient@^2.8
	bblanchon/ArduinoJson@^7.4.2
build_flags =
    -D VERSION_MAJOR=1
    -D VERSION_MINOR=6
    -D VERSION_PATCH=0
    -D AP_SSID_PREFIX=\"esp-setup\"
    -D AP_PASSWORD=\"changeme123\"
board_build.filesystem = littlefs
extra_scripts = post:create_release.py
[env:native]
; Host unit tests only. `pio run -e native` fails by design (no main() in
; these sources); the main() functions live in test/. Run: pio test -e native
platform = native
test_framework = unity
test_build_src = yes
build_src_filter = -<*> +<config_codec.cpp> +<image_detect.cpp> +<net_util.cpp> +<net_decide.cpp>
build_flags = -std=gnu++17 -Iinclude
